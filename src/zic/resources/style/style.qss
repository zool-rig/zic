QWidget {
    background-color: #0D1117;
    color: #E6E9EE;
}

QWidget::disabled {
    color: #8B96A5;
}

QLabel {
    background-color: transparent;
}

QToolButton, QLineEdit, QPushButton {
    padding: 5px;
    background-color: #151B24;
    border-radius: 8px;
    border: 1px solid #2A3342;
}

QToolButton::hover, QLineEdit::hover {
    background-color: #1C2330;
}

QToolButton::pressed {
    background-color: #151B24;
}

#BigToolButton {
    padding: 1px;
    border-radius: 12px;
}

#SmallToolButton {
    padding: 3px;
    border-radius: 6px;
}

#Separator {
    color: #2A3342;
}

QLineEdit {
    padding: 6px
}

QScrollBar {
    background-color: #151B24;
    margin: 4px;
    border-radius: 2px;
    
}

QScrollBar::handle {
    background-color: #35F0E0;
    border-radius: 2px;
    margin: 1px;
}

QScrollBar::handle:hover {
    background-color: #00BFAE;
}

QScrollBar::handle:pressed {
    background-color: #35F0E0;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background-color: transparent;
}

QAbstractItemView, QScrollArea {
    outline: none;
    padding: 4px;
    border-radius: 8px;
    border: 1px solid #2A3342;
}

QAbstractItemView::item {
    padding: 4px;
    border-radius: 4px;
    margin-bottom: 2px;
}

QAbstractItemView::item:hover {
    background-color: #1C2330;
}

QAbstractItemView::item:selected {
    background-color: #35F0E0;
    color: #151B24;
}

QListView#CompleterPopup {
    background-color: #151B24;
    border: 1px solid #2A3342;
    border-radius: 4px;
    outline: none;
}

QListView#CompleterPopup::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin-bottom: 2px;
}

QListView#CompleterPopup::item:hover {
    background-color: #1C2330;
}

QListView#CompleterPopup::item:selected {
    background-color: #35F0E0;
    color: #151B24;
}

#SearchPopup {
    background-color: #151B24;
    border: 1px solid #2A3342;
    border-radius: 8px;
}

QListView#SearchPopupList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListView#SearchPopupList::item {
    padding: 6px 8px;
}

QListView#SearchPopupList::item:disabled {
    color: #8B96A5;
    padding: 8px 8px 2px 8px;
}

QSpinBox {
    padding: 5px;
    background-color: #151B24;
    border-radius: 8px;
    border: 1px solid #2A3342;
}

QSpinBox::hover {
    background-color: #1C2330;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #151B24;
    border: 1px solid #2A3342;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #35F0E0;
}

QCheckBox::indicator:checked {
    background-color: #35F0E0;
    border-color: #35F0E0;
}

QProgressBar {
    background-color: #151B24;
    border: 1px solid #2A3342;
    border-radius: 6px;
    color: #E6E9EE;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #1F8F86;
    border-radius: 5px;
}

QPlainTextEdit {
    background-color: #151B24;
    border: 1px solid #2A3342;
    border-radius: 8px;
}

#DialogTitleLabel {
    font-size: 15pt;
}

#DialogSectionLabel {
    color: #8B96A5;
    font-weight: bold;
    padding-top: 10px;
}

#DialogNoteLabel {
    color: #8B96A5;
    font-style: italic;
}

#DialogErrorLabel {
    color: #FF6B6B;
}

SongWidget[highlighted="true"] {
    background-color: #1C2330;
    border: 1px solid #35F0E0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background-color: #35F0E0;
    margin: 1px;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background-color: #151B24;
    margin: 1px;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background-color: #35F0E0;
    border-radius: 6px;
    border: 1px solid #2A3342;
}

QSlider::handle:horizontal::hover {
    background-color: #00BFAE;
}

QSlider::handle:horizontal::pressed {
    background-color: #35F0E0;
}

#ContainerFrame {
    border-radius: 8px;
    border: 1px solid #2A3342;
    padding: 2px;
}

QMenu {
    padding: 5px;
    border: 1px solid #2A3342;
    border-radius: 4px;
}

QMenu::item {
    padding: 5px;
}

QMenu::item::selected {
    background-color: #1C2330;
    border-radius: 4px;
}

QMenuBar::item {
    padding: 4px;
    padding-bottom: 6px;
    border-radius: 4px
}

QMenuBar::item::selected {
    background-color: #1C2330;
}

#LabelAction {
    padding-bottom: 5px;
}

#AlbumExplorerView::item {
    padding-bottom: 5px;
}

#AlbumExplorerView::item::hover {
    background-color: transparent;
}

#AlbumExplorerView::item::selected {
    background-color: #1C2330;
    border-radius: 8px;
    
}

/* Scroll bars: Qt wraps each scroll bar in a container widget (and adds a
   corner widget where both meet) that inherits the opaque QWidget
   background, drawing dark squares over the rounded frame corners. */
#qt_scrollarea_hcontainer, #qt_scrollarea_vcontainer {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background-color: transparent;
    border: none;
}

/* Disabled state */
QToolButton:disabled, QPushButton:disabled, QLineEdit:disabled {
    background-color: #0D1117;
    border: 1px solid #1C2330;
    color: #4A5466;
}

QLabel:disabled {
    color: #4A5466;
}

QSlider::sub-page:horizontal:disabled {
    background-color: #2A3342;
}

QSlider::add-page:horizontal:disabled {
    background-color: #11161E;
}

QSlider::handle:horizontal:disabled {
    background-color: #3A4556;
    border: 1px solid #2A3342;
}
